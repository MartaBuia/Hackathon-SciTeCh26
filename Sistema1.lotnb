    "value": "DEFINE MODEL FCP11Email COLLAPSED\n    ADD STRING \"email\"\n    ADD STRING \"assunto\"\n    ADD STRING \"estacao\"\n    ADD STRING \"ordem\"\n    ADD STRING \"cor\"\n    ADD STRING \"troco\"\n    ADD STRING \"hora\"\n    ADD STRING \"comboio_a\"\n    ADD STRING \"atraso_se_a\"\n    ADD STRING \"comboio_b\"\n    ADD STRING \"atraso_se_b\"\n    ADD STRING \"explicacao\"\n    ADD STRING \"registado\"\n"
